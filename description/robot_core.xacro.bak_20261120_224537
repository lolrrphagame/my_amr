<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="inertial_macros.xacro"/>

  <!-- REAL ROBOT, metres. Chassis centered at x/y = 0; positive x is FRONT. -->
  <xacro:property name="chassis_length" value="0.250"/>
  <xacro:property name="chassis_width" value="0.250"/>
  <xacro:property name="chassis_height" value="0.150"/>
  <xacro:property name="wheel_radius" value="0.0435"/>
  <xacro:property name="wheel_thickness" value="0.026"/><!-- verify actual wheel thickness -->
  <xacro:property name="wheel_separation" value="0.300"/>
  <xacro:property name="wheel_offset_y" value="${wheel_separation / 2.0}"/>
  <!-- Measured along chassis X: wheel axle is 40 mm ahead of rear face.
       chassis is centered: rear face=-0.125; axle=-0.125+0.040=-0.085 m.
       base_link remains at the midpoint of the two drive wheels. -->
  <xacro:property name="axle_to_rear_face" value="0.040"/>
  <xacro:property name="axle_x_in_chassis" value="${-chassis_length / 2.0 + axle_to_rear_face}"/>
  <xacro:property name="chassis_x_from_axle" value="${-axle_x_in_chassis}"/>
  <xacro:property name="wheel_offset_x" value="0.0"/><!-- base_link is on drive axle -->

  <!-- MEASURED: 73 mm vertical ground clearance to chassis bottom. -->
  <xacro:property name="chassis_ground_clearance" value="0.073"/>
  <!-- base_link lies at the drive axle, approximately wheel_radius above floor. -->
  <xacro:property name="chassis_bottom_from_axle" value="${chassis_ground_clearance - wheel_radius}"/>

  <!-- REPRESENTATIVE mass allocation for a ~4 kg assembled robot including payload;
       not component weighings. Recalibrate inertias before dynamic simulation. -->
  <xacro:property name="chassis_mass" value="3.70"/>
  <xacro:property name="wheel_mass" value="0.09"/>
  <xacro:property name="caster_wheel_mass" value="0.02"/>
  <xacro:property name="caster_wheel_radius" value="0.010"/><!-- approximate visual proxy -->
  <xacro:property name="caster_wheel_x" value="0.075"/><!-- ASSUMED front caster, actual location unknown -->

  <material name="white"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="orange"><color rgba="1.0 0.35 0.08 1"/></material>
  <material name="blue"><color rgba="0.15 0.30 0.9 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="red"><color rgba="0.9 0.1 0.1 1"/></material>

  <link name="base_link"/>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${chassis_x_from_axle} 0 ${chassis_bottom_from_axle}" rpy="0 0 0"/>
  </joint>
  <!-- chassis frame: XY center of chassis, Z at the BOTTOM of enclosure.
       chassis origin relative to base_link: X=+0.085 m, Z=+0.0295 m.
       camera height 0.120 and lid height 0.150 are referenced to that bottom. -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>
  <gazebo reference="chassis"><material>Gazebo/Orange</material></gazebo>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} 0" rpy="${-pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry></collision>
    <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>
  <gazebo reference="left_wheel"><material>Gazebo/Blue</material></gazebo>

  <!-- Axis -Z in mirrored right link gives positive wheel_joint rotation = forward. -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_offset_x} ${-wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry><material name="blue"/></visual>
    <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry></collision>
    <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>
  <gazebo reference="right_wheel"><material>Gazebo/Blue</material></gazebo>

  <!-- A sphere is a SIMPLIFIED placeholder for the swivelling caster.
       X=+0.075 in chassis coordinates is a MODEL ASSUMPTION, NOT a measurement.
       Verify actual front/rear placement, shape and mounting before using Gazebo physics. -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_wheel_x} 0 ${caster_wheel_radius - chassis_ground_clearance}" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel">
    <visual><geometry><sphere radius="${caster_wheel_radius}"/></geometry><material name="white"/></visual>
    <collision><geometry><sphere radius="${caster_wheel_radius}"/></geometry></collision>
    <xacro:inertial_sphere mass="${caster_wheel_mass}" radius="${caster_wheel_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>
  <gazebo reference="caster_wheel"><material>Gazebo/White</material><mu1 value="0.001"/><mu2 value="0.001"/></gazebo>
</robot>
