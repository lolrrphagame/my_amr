<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!--
      sim_mode=false: REAL robot / visualization only.
        No Gazebo motion plugin and no GazeboSystem ros2_control.
        ESP32-S3 remains controlled by the existing safe serial bridge.
      sim_mode=true: Gazebo Classic, using ros2_control or diff_drive plugin.
    -->
    <xacro:arg name="sim_mode" default="false"/>
    <xacro:arg name="use_ros2_control" default="false"/>

    <!-- Keep the user's local, calibrated robot_core.xacro / sensor files. -->
    <xacro:include filename="robot_core.xacro" />

    <xacro:if value="$(arg sim_mode)">
        <xacro:if value="$(arg use_ros2_control)">
            <xacro:include filename="ros2_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg use_ros2_control)">
            <xacro:include filename="gazebo_control.xacro" />
        </xacro:unless>
    </xacro:if>

    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="camera.xacro" />

    <!-- Josh face decoration intentionally not loaded for AMR. -->
</robot>
