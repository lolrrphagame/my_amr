<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Raspberry Pi camera: centred horizontally on the +X/front chassis face.
       Camera optical/lens centre is 120 mm above the CHASSIS BOTTOM plane.
       With chassis ground clearance 57 mm, camera is 177 mm above the floor.
       Camera link uses ROS body axes (+X forward, +Y left, +Z up).
       Visual board/housing/lens are deliberately approximate, not CAD measurements. -->

  <xacro:property name="camera_height_above_chassis_bottom" value="0.120"/>
  <xacro:property name="camera_board_thickness" value="0.003"/>
  <xacro:property name="camera_board_width" value="0.025"/>
  <xacro:property name="camera_board_height" value="0.024"/>
  <xacro:property name="camera_housing_depth" value="0.008"/>
  <xacro:property name="camera_housing_size" value="0.012"/>
  <xacro:property name="camera_lens_radius" value="0.0045"/>
  <xacro:property name="camera_lens_depth" value="0.003"/>

  <material name="camera_pcb_green">
    <color rgba="0.06 0.30 0.16 1.0"/>
  </material>
  <material name="camera_housing_black">
    <color rgba="0.05 0.06 0.07 1.0"/>
  </material>
  <material name="camera_lens_glass">
    <color rgba="0.08 0.15 0.24 1.0"/>
  </material>

  <link name="camera_link">
    <!-- Board is flush with the front chassis surface. -->
    <visual name="camera_board_visual">
      <origin xyz="0.0015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_board_thickness} ${camera_board_width} ${camera_board_height}"/>
      </geometry>
      <material name="camera_pcb_green"/>
    </visual>

    <!-- Central lens housing projects towards +X. -->
    <visual name="camera_housing_visual">
      <origin xyz="0.007 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_housing_depth} ${camera_housing_size} ${camera_housing_size}"/>
      </geometry>
      <material name="camera_housing_black"/>
    </visual>

    <!-- Cylinders extend along local Z, so rotate +90 degrees about Y
         to point the circular lens forwards along +X. -->
    <visual name="camera_lens_visual">
      <origin xyz="0.0125 0 0" rpy="0 ${pi/2.0} 0"/>
      <geometry>
        <cylinder radius="${camera_lens_radius}" length="${camera_lens_depth}"/>
      </geometry>
      <material name="camera_lens_glass"/>
    </visual>

    <!-- Simplified rigid collision envelope; no precision camera mechanics. -->
    <collision>
      <origin xyz="0.0075 0 0" rpy="0 0 0"/>
      <geometry><box size="0.015 ${camera_board_width} ${camera_board_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.0075 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000002" ixy="0" ixz="0"
               iyy="0.000002" iyz="0" izz="0.000002"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <!-- Chassis origin is at the box centre.
         z = +120 mm from bottom = 120 - body_height/2 from centre. -->
    <origin xyz="${body_length/2.0} 0 ${camera_height_above_chassis_bottom - body_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Preserve the optical frame required by camera drivers and visualisation.
       The optical axes are: +Z forwards, +X right, +Y down. -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0.0125 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>
</robot>
