<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Camera lens at the CENTRE of the front face (+X), 120 mm from FLOOR (subtract chassis ground clearance).
       Camera points forward in +X; y=0. Height is measured from the floor. -->
  <xacro:property name="camera_height_above_bottom" value="${0.120 - chassis_ground_clearance}"/>
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2.0} 0 ${camera_height_above_bottom}" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <!-- Small simplified camera module on front face. -->
      <origin xyz="0.005 0 0" rpy="0 0 0"/>
      <geometry><box size="0.010 0.025 0.024"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <!-- Optical convention: +Z forward, +X right, +Y down. -->
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_link_optical"/>
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image><format>R8G8B8</format><width>640</width><height>480</height></image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
