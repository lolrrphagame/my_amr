<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Camera front center, height 120 mm from ground -->
  <xacro:property name="camera_height_from_ground" value="0.120"/>
  <xacro:property name="camera_x_from_base" value="0.125"/>
  <xacro:property name="camera_y_from_base" value="0.000"/>
  <xacro:property name="camera_z_from_base" value="${camera_height_from_ground - wheel_radius}"/>
  <xacro:property name="camera_box_x" value="0.018"/>
  <xacro:property name="camera_box_y" value="0.018"/>
  <xacro:property name="camera_box_z" value="0.012"/>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x_from_base} ${camera_y_from_base} ${camera_z_from_base}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame for image pipeline -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

</robot>
