<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Camera in middle of front face, 120 mm above ground, pointing +X. -->
  <xacro:property name="camera_height_from_ground" value="0.120"/>
  <xacro:property name="camera_box_x" value="0.018"/>
  <xacro:property name="camera_box_y" value="0.018"/>
  <xacro:property name="camera_box_z" value="0.012"/>

  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="${body_length/2.0} 0 ${camera_height_from_ground - body_center_z_from_base}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>
</robot>
