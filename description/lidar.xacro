<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Lidar at the XY CENTRE of the top lid of 250x250x150 mm enclosure.
       laser_frame marks the scanning plane, not the foot of the sensor.
       55 mm above lid is the USER-MEASURED scanning-plane offset. -->
  <xacro:property name="lidar_scan_above_lid" value="0.055"/>
  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 ${chassis_height + lidar_scan_above_lid}" rpy="0 0 0"/>
  </joint>
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.040"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.040"/></geometry>
    </collision>
    <!-- The lidar mass is a placeholder included in the approximate 4 kg model. -->
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000494" ixy="0" ixz="0" iyy="0.0000494" iyz="0" izz="0.0000722"/>
    </inertial>
  </link>
  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
    <sensor name="laser" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max></range>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><argument>~/out:=scan</argument></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
