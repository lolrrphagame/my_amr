<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- LiDAR support and LiDAR body -->
  <xacro:property name="lidar_radius" value="0.030"/>
  <xacro:property name="lidar_height" value="0.030"/>
  <xacro:property name="lidar_x_from_base" value="0.085"/>
  <xacro:property name="lidar_y_from_base" value="0.000"/>

  <!-- Requested: distance from chassis TOP LID to lidar CENTER is 5.5 cm -->
  <xacro:property name="lidar_center_above_lid" value="0.055"/>
  <xacro:property name="lidar_center_z_from_base" value="${chassis_z_from_base + body_height/2.0 + lidar_center_above_lid}"/>
  <xacro:property name="lidar_post_radius" value="0.006"/>
  <xacro:property name="lidar_post_length" value="${lidar_center_z_from_base - (chassis_z_from_base + body_height/2.0) - lidar_height/2.0}"/>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x_from_base} ${lidar_y_from_base} ${lidar_center_z_from_base}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_post">
    <visual>
      <origin xyz="0 0 ${lidar_post_length/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_post_radius}" length="${lidar_post_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="lidar_post_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_post"/>
    <origin xyz="${lidar_x_from_base} ${lidar_y_from_base} ${body_height/2.0}" rpy="0 0 0"/>
  </joint>

</robot>
