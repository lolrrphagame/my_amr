<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- The laser/lidar body is centered over the 250 x 250 mm chassis lid.
       Measured LiDAR body centre (laser_frame) is 55 mm above the lid. -->
  <xacro:property name="lidar_radius" value="0.030"/>
  <xacro:property name="lidar_height" value="0.030"/>
  <xacro:property name="lidar_center_above_lid" value="0.055"/>
  <xacro:property name="lidar_post_radius" value="0.006"/>
  <xacro:property name="lidar_post_length" value="${lidar_center_above_lid - lidar_height/2.0}"/>

  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="black"/>
    </visual>
    <collision><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry></collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 ${body_height/2.0 + lidar_center_above_lid}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_post">
    <visual>
      <geometry><cylinder radius="${lidar_post_radius}" length="${lidar_post_length}"/></geometry>
      <material name="gray"/>
    </visual>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="lidar_post_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_post"/>
    <origin xyz="0 0 ${body_height/2.0 + lidar_post_length/2.0}" rpy="0 0 0"/>
  </joint>
</robot>
