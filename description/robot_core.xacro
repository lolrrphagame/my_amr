<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= Geometry / dimensions ================= -->
  <xacro:property name="pi" value="3.1415926535897931"/>

  <!-- Body -->
  <xacro:property name="body_length" value="0.250"/>
  <xacro:property name="body_width"  value="0.250"/>
  <xacro:property name="body_height" value="0.150"/>
  <xacro:property name="body_color"  value="orange"/>

  <!-- Ground / wheel geometry -->
  <xacro:property name="ground_clearance" value="0.073"/>
  <xacro:property name="wheel_radius" value="0.0435"/>
  <xacro:property name="wheel_length" value="0.020"/>
  <xacro:property name="wheel_separation" value="0.300"/>
  <xacro:property name="wheel_x_from_center" value="0.085"/>

  <!-- Caster (simple placeholder) -->
  <xacro:property name="caster_radius" value="0.012"/>
  <xacro:property name="caster_x_from_center" value="-0.085"/>

  <!-- base_link at midpoint between the two drive wheel centers -->
  <!-- Chassis center is above base_link by wheel_radius + (body_height/2 - ground_clearance) -->
  <xacro:property name="chassis_z_from_base" value="${wheel_radius + (body_height/2.0 - ground_clearance)}"/>

  <material name="orange"><color rgba="1.0 0.35 0.0 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="white"><color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>

  <!-- Optional footprint for nav -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- Chassis -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_z_from_base}" rpy="0 0 0"/>
  </joint>

  <!-- Left drive wheel -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="${wheel_x_from_center} ${wheel_separation/2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right drive wheel -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="${wheel_x_from_center} ${-wheel_separation/2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Simple caster placeholder -->
  <link name="caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${caster_x_from_center} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

</robot>
